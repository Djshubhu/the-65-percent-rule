---
const { checkoutUrl, price } = Astro.props;
---

<div class="mobile-cta">
  <a class="btn btn--primary" href={checkoutUrl}>
    Get the book · {price} <span class="arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .mobile-cta {
    display: none;
  }

  @media (max-width: 820px) {
    .mobile-cta {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
      background: linear-gradient(to top, rgba(15, 12, 9, 0.92), rgba(15, 12, 9, 0));
    }

    .mobile-cta .btn {
      width: 100%;
      justify-content: center;
      box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.6);
    }

    body {
      padding-bottom: 4.6rem;
    }
  }
</style>