---
import '../styles/global.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION, CHECKOUT_URL, PRICE, FAQ_ITEMS } from '../config';

const ogImage = new URL('cover.jpg', SITE_URL).href;

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: 'The 65% Rule',
  alternateName: 'The 65% Rule — The Quiet Mechanics of True Wealth Builders',
  description: SITE_DESCRIPTION,
  inLanguage: 'en',
  genre: 'Personal Finance',
  offers: {
    '@type': 'Offer',
    price: '199',
    priceCurrency: 'INR',
    url: new URL(CHECKOUT_URL, SITE_URL).href,
    availability: 'https://schema.org/PreOrder',
  },
  image: ogImage,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const title = SITE_TITLE;
const description = SITE_DESCRIPTION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE_URL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="The 65% Rule" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0f0c09" />

    <!-- Google tag (gtag.js) — GA4 property G-8BLY3BHGM8 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8BLY3BHGM8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8BLY3BHGM8');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>